# Ollama в Docker
COMPOSE_PROFILES=ollama
LLM_BASE_URL=http://ollama:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=qwen3:8b
LLM_REASONING_EFFORT=none

# Ollama локально: ollama create qwen3-8b-16k -f ollama/Modelfile.qwen3
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=qwen3-8b-16k

# OpenRouter (убрать COMPOSE_PROFILES)
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_API_KEY=sk-or-...
# LLM_MODEL=dots-studio/dots-3-note-preview:free
# LLM_FALLBACK_MODELS=xingchen-agi/xing4.0-29b-a4b:free,nvidia/nemotron-3-super-120b-a12b:free
# LLM_REASONING_EFFORT=low
# LLM_MAX_TOKENS=32000
# PII_MASKING=true

# OpenAI
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=sk-...
# LLM_MODEL=gpt-4o-mini

OCR_ENABLED=true
OCR_LANG=rus+eng
# если tesseract не в PATH (Windows)
# TESSERACT_CMD=C:/Program Files/Tesseract-OCR/tesseract.exe
# TESSDATA_DIR=C:/Users/me/tessdata
PII_MASKING=false
PII_NAMES=false
WORKER_MAX_JOBS=2
